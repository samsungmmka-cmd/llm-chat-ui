# Copy to .env.local for `npm run dev` (restart the dev server after changing it).
# The Vite dev server proxies /api/* to this URL — include the full path to /v1, no trailing slash.
# Examples:
#   LLM_UPSTREAM=http://192.168.1.20/llm/v1
#   LLM_UPSTREAM=http://localhost:8000/v1
LLM_UPSTREAM=http://localhost:8000/v1
